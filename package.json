{
  "name": "temple-kitchen-safety",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vite --mode cloudflare",
    "build": "tsc -p tsconfig.json && vite build",
    "build:cf": "tsc -p tsconfig.json && vite build --mode cloudflare",
    "cf:dev": "npm run build:cf && wrangler pages dev",
    "db:migrate:local": "wrangler d1 migrations apply temple-kitchen-safety --local",
    "db:migrate:remote": "wrangler d1 migrations apply temple-kitchen-safety --remote",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p functions/tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "jose": "^6.2.18",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.2",
    "wrangler": "^4.166.0"
  }
}
